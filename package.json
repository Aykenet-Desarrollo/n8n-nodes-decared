{
	"name": "@aykenet/n8n-nodes-decared",
	"version": "0.1.0",
	"description": "n8n nodes for DeCAred: Spanish road-transport control documents (DeCA), drafts, master data and instant document events.",
	"license": "MIT",
	"homepage": "https://decared.com/integraciones/documentacion",
	"keywords": [
		"n8n-community-node-package",
		"decared",
		"deca",
		"transport",
		"logistics"
	],
	"author": {
		"name": "AYKENET",
		"email": "info@decared.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Aykenet-Desarrollo/n8n-nodes-decared.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DeCAredApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DeCAred/DeCAred.node.js",
			"dist/nodes/DeCAredTrigger/DeCAredTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
